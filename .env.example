# Copy to .env and fill in. Never commit .env or share it.
# Long random string. Create one with: openssl rand -hex 32
PAYLOAD_SECRET=
# Public address of the site (no trailing slash). Use http://localhost:3000 on your own computer.
SITE_URL=https://kidztimeschool.com
# Domain only, used by the HTTPS web server (Caddy) in production.
DOMAIN=kidztimeschool.com
# Optional overrides. Docker already sets these to /data.
# SQLITE_URL=file:./kidztime.db
# MEDIA_DIR=./media

# Optional: e-mail an alert for each new enquiry (leave blank to skip; enquiries always appear in the admin panel).
# For Gmail, create an "app password" (Google Account > Security > 2-Step Verification > App passwords).
NOTIFY_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
